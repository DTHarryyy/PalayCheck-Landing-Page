# "coming_soon" (default) or "live". Switch to "live" once the Google Play listing is public.
NEXT_PUBLIC_APP_STATUS=coming_soon

# Optional. Defaults to https://play.google.com/store/apps/details?id=app.palaycheck.com
# Must be an https://play.google.com URL; the build fails otherwise.
NEXT_PUBLIC_PLAY_STORE_URL=

# Optional. Canonical site URL for metadata, sitemap and OG image links.
# Defaults to the Vercel production URL, or http://localhost:3000 locally.
NEXT_PUBLIC_SITE_URL=
